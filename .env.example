# Plantilla de configuración. Copiar a .env y rellenar. Todas las variables están
# explicadas en docs/FUNCIONALIDADES.md (sección "Configuración").

# ─── Discord (obligatorias) ───────────────────────────────────────────────────
TOKEN=
CLIENT_ID=
GUILD_ID=
# Estados del bot separados por comas ("Viendo ...")
ESTADOS=

# ─── IA: Gemini (obligatoria para el Duende, /ia, /imagen y TTS) ─────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
IMAGE_GEN_MODEL=
DUENDE_MAX_TOKENS=1024
DUENDE_MAX_TOKENS_FALLBACK=512
DUENDE_HISTORY_LIMIT=20
DUENDE_DAILY_LIMIT=50

# ─── Apuestas deportivas (obligatoria para /juegos → Apuestas y la quiniela) ─
ODDS_API_KEY=
# Avisar por DM a los admins cuando queden menos créditos de la Odds API que esto
# ODDS_CREDITOS_AVISO=50

# ─── Integraciones opcionales ─────────────────────────────────────────────────
GIPHY_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=
SEERR_URL=
SEERR_API_KEY=

# ─── Voz: TTS con Gemini (/tts y las respuestas habladas del Duende) ─────────
# Si no se pone, gemini-3.8-flash-tts. No usar gemini-2.5-flash-preview-tts: Google lo está retirando y
# responde sin audio (igualmente se prueba el de por defecto si el configurado falla).
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts
# GEMINI_TTS_STYLE=
# DUENDE_TTS_VOICE=Puck

# ─── Voz (STT con Vosk) ───────────────────────────────────────────────────────
# STT_ENABLED=1

# ─── Voz en directo con Gemini Live (/conversación) ─────────────────────────────
# Modelo de audio bidireccional en tiempo real; no confundir con GEMINI_TTS_MODEL (por lotes).
# DUENDE_LIVE_MODEL=gemini-live-2.5-flash-preview
# DUENDE_LIVE_VOICE=Puck
# Se cobra mientras la conexión esté abierta, no solo cuando se habla: estos dos cortes no son
# opcionales. Minutos sin que nadie hable (por defecto 5 min) y tope duro de duración (30 min).
# DUENDE_LIVE_IDLE_DISCONNECT_MS=300000
# DUENDE_LIVE_MAX_DURATION_MS=1800000

# ─── Logs ─────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# LOG_CONSOLE_LEVEL=warn
