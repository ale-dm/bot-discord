{
  "name": "el-duende",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Discord El Duende: IA conversacional, XP, economía, casino, apuestas, cripto y Plex",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "start:bot": "node src/core/registerCommands.js && node src/index.js",
    "start:vosk": "node scripts/start-vosk.js",
    "commands": "node src/core/registerCommands.js",
    "test": "jest",
    "db:check": "node scripts/db-check.js",
    "stt:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-stt.ps1 -NoStart",
    "stt:test": "node scripts/stt-test.js",
    "voz:test": "node scripts/voz-test.js",
    "db:backup": "node scripts/db-backup.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "eslint . && prettier --check . && jest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.24.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^12.2.0",
    "canvas": "^3.2.1",
    "discord.js": "^14.22.0",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.1",
    "libsodium-wrappers": "^0.8.2",
    "node-cron": "^4.6.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.1.3",
    "prettier": "^3.9.9"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testEnvironment": "node"
  }
}
